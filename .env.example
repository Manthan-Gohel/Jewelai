# ========================================================
# JewelAI Production Environment Configuration Template
# ========================================================

# Environment
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="JewelAI"
VERSION=1.0.0
DOMAIN=your-domain.com

# Database & Cache
# Use a long URL-safe password; Compose constructs DATABASE_URL from these values.
POSTGRES_USER=jewelai_admin
POSTGRES_PASSWORD=
POSTGRES_DB=jewelai_db
REDIS_URL=redis://redis:6379/0

# Security (Generate random 32+ character secrets in production)
SECRET_KEY=
# Fernet 32 url-safe base64 key: generate via `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
ENCRYPTION_KEY=
# Invite code to gate registration (invite-only)
REGISTRATION_INVITE_CODE=
ENABLE_OPEN_REGISTRATION=False
ENABLE_DIRECT_TOKEN_CONNECT=False
MOCK_INSTAGRAM_API=False
MOCK_AI_PROVIDER=False

# Meta Instagram API Credentials (From Meta Developer Portal)
# https://developers.facebook.com/apps/
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_REDIRECT_URI=https://your-domain.com/auth/instagram/callback
META_API_VERSION=v22.0

# Google Gemini AI Credentials
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Automation Policy & Caps
COMMENT_AUTO_DM_DAILY_CAP=50
MESSAGING_WINDOW_HOURS=24
